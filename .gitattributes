# Normalize line endings in the repository; shell scripts stay LF on every OS.
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
# Data files are compared byte for byte: store them exactly as generated (CRLF from Python's csv module).
*.csv -text
data/**/*.json -text
samples/*.json -text
tests/fixtures/**/*.json -text
*.xlsx binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
